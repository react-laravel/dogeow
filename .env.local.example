# Public API endpoints
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=/api

# Public realtime config
NEXT_PUBLIC_REVERB_APP_KEY=your-reverb-app-key
NEXT_PUBLIC_REVERB_HOST=localhost
NEXT_PUBLIC_REVERB_PORT=8080
NEXT_PUBLIC_REVERB_SCHEME=http

# Public asset CDN base URL
# Leave empty to use local /public assets during local development.
NEXT_PUBLIC_ASSET_BASE_URL=

# Knowledge / Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:0.6b
NEXT_PUBLIC_OLLAMA_ACCESS_MODE=auto
KNOWLEDGE_EMBEDDING_MODEL=nomic-embed-text
KNOWLEDGE_SEARCH_METHOD=rag

# ChatGPT / Codex outbound proxy (Squid). Used by server-side direct API calls.
# Prefer CODEX_HTTP_PROXY; falls back to WEBPUSH_HTTP_PROXY / HTTPS_PROXY / HTTP_PROXY.
# CODEX_HTTP_PROXY=http://user:pass@127.0.0.1:3129
# WEBPUSH_HTTP_PROXY=http://user:pass@127.0.0.1:3129

# Optional integrations
GITHUB_PAT=
NEXT_PUBLIC_ERROR_REPORTING_ENDPOINT=
# Sentry (leave empty to disable client/server init)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
